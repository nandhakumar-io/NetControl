# ==============================================================================
# NetControl — Environment Configuration Example (.env.example)
# ==============================================================================
# Copy this file to .env and .env.local before deploying:
#   cp .env.example .env
#   cp .env.example .env.local
#
# IMPORTANT: Replace all placeholder values marked with CHANGE_ME_* with strong,
# unique random keys before deploying to production.
# ==============================================================================

# ── General & Server Environment ──────────────────────────────────────────────
NODE_ENV=production
PORT=8000
PROCESS_ROLE=web
WEB_WORKERS=4
CORS_ORIGIN=http://localhost:8080
COOKIE_DOMAIN=
TRUST_PROXY_HOPS=2

# ── Required Cryptographic Secrets ───────────────────────────────────────────
# JWT_SECRET: High-entropy secret for signing JWT access tokens (min 64 hex chars).
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_HEX_64_CHARS_FOR_JWT_ACCESS_TOKEN_SIGNING

# JWT_REFRESH_SECRET: Secret for signing JWT refresh tokens.
# Generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_HEX_64_CHARS_FOR_JWT_REFRESH_TOKEN_SIGNING
JWT_EXPIRY=8h
JWT_REFRESH_EXPIRY=7d

# CREDENTIAL_ENCRYPTION_KEY: AES-256-GCM key for encrypted credentials & backups.
# CRITICAL: MUST BE EXACTLY 32 CHARACTERS (e.g. 16 hex bytes).
# Generate with: openssl rand -hex 16
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_EXACTLY_32_CHARS_KEY!

# ── Action PIN ────────────────────────────────────────────────────────────────
# Required before executing destructive or high-privilege actions (shutdown,
# restart, wake-on-LAN, wiping, backups, bulk command, network discovery).
# Store only the bcrypt hash here — NEVER the plaintext PIN.
# Default hash below corresponds to PIN: 1234
# To generate a hash for a custom PIN:
#   node -e "require('bcryptjs').hash('YOUR_NEW_PIN', 12).then(console.log)"
ACTION_PIN_HASH=$2a$12$PrfgkKgZJ2vOL4L/K1ViT.L0N8xJU4lTG5xvW0dL1o0vjPOPogNTm
PIN_ATTEMPT_THRESHOLD=5
PIN_ATTEMPT_WINDOW_SEC=300
PIN_LOCKOUT_SEC=900

# ── MySQL Database Configuration ──────────────────────────────────────────────
# In Docker Compose, the service name is 'mysql'. For host execution use 'localhost'.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=netcontrol
DB_USER=netcontrol
DB_PASSWORD=CHANGE_ME_STRONG_DB_USER_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_DB_ROOT_PASSWORD
DB_POOL_SIZE=100

# ── Redis (Cross-Process Pub/Sub Event Bus) ────────────────────────────────────
# In Docker Compose, the service name is 'redis'.
REDIS_URL=redis://redis:6379

# ── Agent Enrollment & Communication ──────────────────────────────────────────
# Secret for legacy agent registration when not using per-org enrollment tokens.
# Generate with: openssl rand -hex 24
AGENT_REGISTRATION_SECRET=CHANGE_ME_AGENT_REGISTRATION_SECRET
AGENT_RELEASE_DIR=/app/data/agent-release
AGENT_UPDATE_GRACE_SEC=600
AGENT_INGEST_LIMIT=60
AGENT_RELAY_LIMIT=6000

# ── Web Push Notifications (VAPID) ────────────────────────────────────────────
# Used for browser and mobile PWA push notifications.
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=BI7y09BqDy5qQLYBa5BQVDlLSNwDsmFV7nNXqrrMdySVcBZkELDaYU4V3QBhEc0-dTLdoTaezoXMdkYoCZNEclI
VAPID_PRIVATE_KEY=UGtbNeExYQLIGdB9R6cv3pWANT5CTncwcICsE2dW1Do
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Backups & Storage ─────────────────────────────────────────────────────────
BACKUP_ROOT=/app/backup-source
BACKUP_STORE_DIR=/app/backups
BACKUP_RETENTION_COUNT=20
BACKUP_ENCRYPT_LOCAL=false
SLA_REPORTS_DIR=/app/sla-reports

# ── Rate Limiting & Protection ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
ACTION_RATE_LIMIT_MAX=1000
BULK_IMPORT_RATE_LIMIT_MAX=10
DISCOVERY_RATE_LIMIT_MAX=6
REGISTER_RATE_LIMIT=1000
SSE_STREAM_RATE_LIMIT=60
API_KEY_RATE_LIMIT_MAX=3000

# ── Brute Force Protection ────────────────────────────────────────────────────
BF_THRESHOLD=5
BF_WINDOW_SEC=300
BF_MAX_BAN_SEC=86400

# ── Metrics Compaction & Log Retention ────────────────────────────────────────
AUDIT_LOG_RETENTION_DAYS=365
METRICS_COMPRESS_AFTER_DAYS=35
METRICS_DAILY_RETENTION_DAYS=730
METRICS_RETENTION_DAYS=395
CAPACITY_WARNING_DAYS=7
CAPACITY_CRITICAL_DAYS=2
CAPACITY_RENOTIFY_HOURS=24

# ── Email / SMTP Notifications (Optional) ─────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=alerts@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="NetControl Alerts <alerts@example.com>"

# ── Google OAuth Single Sign-On (Optional) ────────────────────────────────────
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_ALLOWED_DOMAIN=yourdomain.com
# GOOGLE_AUTO_PROVISION=false
# GOOGLE_DEFAULT_ROLE=viewer
# BACKEND_URL=https://netcontrol.yourdomain.com

# ── SIEM / Syslog Audit Forwarding (Optional) ─────────────────────────────────
# SYSLOG_SERVER_HOST=
# SYSLOG_SERVER_PORT=514
# SYSLOG_PROTOCOL=udp
# SYSLOG_REPORTED_HOSTNAME=netcontrol-server

# ── SEB Server 2.2 (Safe Exam Browser) integration ────────────────────────────
# NetControl asks SEB Server to send a SEB_QUIT instruction to the selected
# clients, waits for each client to report it has exited, and only then (if
# requested) shuts the Windows PC down. Leave SEB_SERVER_URL empty to disable.
# Note: Bundled non-SSL SEB Server typically runs plain HTTP on port 8081 (e.g. http://10.120.6.244:8081)
SEB_SERVER_URL=http://your-seb-server-ip:8081
# Verify against your deployment — the admin API prefix on SEB Server 2.2.
SEB_API_PREFIX=/admin-api/v1
# password (admin-API OAuth2 password grant) | client_credentials | static
SEB_AUTH_MODE=password
SEB_TOKEN_PATH=/oauth/token
SEB_CLIENT_ID=guiClient
# Note: For SEB Server 2.2 bundled setup, the OAuth client secret matches the SEB Server master password (SEBSERVER_PWD).
SEB_CLIENT_SECRET=CHANGE_ME_SEBSERVER_PWD
SEB_USERNAME=sebserver-admin
SEB_PASSWORD=CHANGE_ME_SEB_ADMIN_PASSWORD
# SEB_STATIC_TOKEN=            # only when SEB_AUTH_MODE=static
# How the instruction POST body is encoded: json | form
SEB_INSTRUCTION_ENCODING=json
# Optional exam id pre-filled in the UI (e.g. 1, 2, or quiz name)
SEB_DEFAULT_EXAM_ID=
# Seconds to wait for SEB to report exit before giving up (no shutdown is sent on timeout)
SEB_QUIT_TIMEOUT_SEC=120
SEB_POLL_INTERVAL_MS=3000
# Grace period between "SEB exited" and the shutdown command
SEB_SHUTDOWN_DELAY_SEC=5
# Also confirm over WinRM (tasklist) that the SEB process is gone before shutdown.
# If WinRM is unreachable the check is skipped and SEB Server's status is trusted.
SEB_VERIFY_PROCESS=true
SEB_PROCESS_FILTER=SafeExamBrowser*
SEB_HTTP_TIMEOUT_MS=10000